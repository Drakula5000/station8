# Required
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Primary account
OWNER_PASSWORD=

# Optional second full account. Put the real value only in Render or a private
# local .env; never commit it to this example file or source control.
S8_SECONDARY_PASSWORD=

# Supabase (required for persistent storage; use the server-only legacy
# service_role JWT, never a publishable/anon key or any VITE_ frontend variable)
SUPABASE_URL=
SUPABASE_KEY=

# Google OAuth (optional — enables Google Docs/Sheets integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5001/api/google/callback
